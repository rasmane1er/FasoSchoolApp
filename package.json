{
  "name": "fasoschool",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme de gestion scolaire pour les etablissements prives du Burkina Faso",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "db:migrate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/0001_initial.sql -f db/migrations/0002_reference_data.sql",
    "db:test:rls": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/tests/rls_isolation.sql",
    "test": "node --experimental-strip-types --test tests/",
    "test:bulletin": "node --experimental-strip-types --test tests/bulletin.test.ts",
    "demo": "node --experimental-strip-types scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "start": "node --experimental-strip-types src/server/app.ts",
    "test:e2e": "node tests/app.e2e.mjs",
    "check:all": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "playwright": "^1.49.0",
    "typescript": "^5.9.3"
  }
}
