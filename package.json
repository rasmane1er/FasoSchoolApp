{
  "name": "fasoschool",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme de gestion scolaire pour les etablissements prives du Burkina Faso",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "db:migrate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/0001_initial.sql -f db/migrations/0002_reference_data.sql -f db/migrations/0003_guardian_access.sql",
    "db:test:rls": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/tests/rls_isolation.sql",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:bulletin": "node --experimental-strip-types --test tests/bulletin.test.ts",
    "demo": "node --experimental-strip-types scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "start": "node --experimental-strip-types src/server/app.ts",
    "test:e2e": "node tests/app.e2e.mjs",
    "test:offline": "node tests/offline.e2e.mjs",
    "check:all": "npm run typecheck && npm test && npm run test:rentree && npm run test:e2e && npm run test:offline && npm run test:import && npm run test:conseil && npm run test:famille && npm run test:categorisation && npm run test:services && npm run test:cloture",
    "test:import": "node tests/import.e2e.mjs",
    "test:rentree": "node tests/rentree.e2e.mjs",
    "test:conseil": "node tests/conseil.e2e.mjs",
    "test:famille": "node tests/famille.e2e.mjs",
    "test:categorisation": "node tests/categorisation.e2e.mjs",
    "db:sauvegarde": "./scripts/sauvegarde.sh",
    "db:epreuve": "./scripts/restauration-verifiee.sh",
    "test:services": "node tests/services.e2e.mjs",
    "test:cloture": "node tests/cloture.e2e.mjs"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "playwright": "^1.49.0",
    "typescript": "^5.9.3"
  }
}
