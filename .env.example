# Base de donnees. L'utilisateur applicatif NE DOIT PAS etre superutilisateur :
# un superutilisateur contourne entierement le row-level security.
DATABASE_URL=postgres://schoolfaso_app:motdepasse@localhost:5432/schoolfaso
PGPOOL_MAX=10

# SMS. "mock" en developpement, "orange_bf" en production.
# Orange Burkina SMS API 2.0 : libre-service sur developer.orange.com,
# ~8 FCFA par message, atteint tous les operateurs du pays.
SMS_PROVIDER=mock
SMS_COST_FCFA=8
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=

# Mobile Money : PAS AVANT LE RCCM.
# Le Burkina Faso n'est pas couvert par l'API publique Orange Money et Moov
# n'a aucune API publique. Le chemin realiste est un agregateur (LigdiCash,
# burkinabe, ou PayDunya) et tous exigent une entreprise enregistree.
PAYMENT_PROVIDER=none
